# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice pipeline
NEXT_PUBLIC_VOICE_PIPELINE_URL=
NEXT_PUBLIC_APP_ENVIRONMENT=dev

# Deepgram
DEEPGRAM_API_KEY=

# App URL (used for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional emails)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@yourdomain.com

# Internal API auth (shared secret with voice-pipeline)
INTERNAL_API_KEY=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cookie domain for cross-subdomain auth (e.g. .brewdock.ai)
NEXT_PUBLIC_COOKIE_DOMAIN=

# Lander URL for CORS (e.g. https://brewdock.ai)
LANDER_URL=
