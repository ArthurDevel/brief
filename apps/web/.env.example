# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice pipeline
NEXT_PUBLIC_VOICE_PIPELINE_URL=
NEXT_PUBLIC_APP_ENVIRONMENT=dev

# Deepgram
DEEPGRAM_API_KEY=

# App URL (used for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional emails)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@yourdomain.com
RESEND_FROM_NAME=BrewDock

# Internal API auth (shared secret with voice-pipeline)
INTERNAL_API_KEY=

# Onboarding token secret (shared with lander, for pre-email-confirmation auth)
ONBOARDING_TOKEN_SECRET=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cookie domain for cross-subdomain auth (e.g. .brewdock.ai)
NEXT_PUBLIC_COOKIE_DOMAIN=

# Lander URL for CORS and engagement email links (e.g. https://brewdock.ai)
LANDER_URL=

# Cron secret for Vercel Cron authentication
CRON_SECRET=

# Admin user IDs (comma-separated UUIDs that can access /admin/*)
ADMIN_USER_IDS=

# Unipile (hosted email auth and account management)
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_NOTIFY_SECRET=

# Composio (WhatsApp Gmail connector)
COMPOSIO_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=23
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_FROM_NUMBER=
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
