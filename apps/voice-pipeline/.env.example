# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=

# OpenRouter (LLM)
OPENROUTER_API_KEY=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Web app (for end-of-session hook)
WEB_APP_URL=http://localhost:3000
INTERNAL_API_KEY=

# Server
PORT=7860
PUBLIC_URL=http://localhost:7860

# Metered TURN server (for WebRTC connectivity behind proxies)
METERED_API_KEY=

# Call recording (stores WAV in Supabase Storage for admin debugging)
RECORDING_ENABLED=false

# Play a short repeating phone-style startup tone until the assistant or caller speaks
STARTUP_TONE_ENABLED=true

# IMAP integration tests (optional — only needed to run Gmail e2e tests)
TEST_IMAP_HOST=imap.gmail.com
TEST_IMAP_PORT=993
TEST_IMAP_USER=
TEST_IMAP_PASSWORD=

# Twilio (used by dev-server-start.sh and the scheduled-call scheduler)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Environment ("dev" or "prod") -- determines which company phone numbers are used
APP_ENVIRONMENT=dev

# Unipile (email provider integration for Gmail/Outlook)
UNIPILE_API_KEY=
UNIPILE_DSN=
