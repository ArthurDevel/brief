# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=

# OpenRouter (LLM)
OPENROUTER_API_KEY=

# LLM model (default: google/gemini-3-flash-preview)
LLM_MODEL=google/gemini-3-flash-preview

# TTS voice (default: aura-2-helena-en)
TTS_VOICE=aura-2-helena-en

# Server port (default: 7860)
PORT=7860

# Public URL for Twilio webhooks (default: http://localhost:7860)
PUBLIC_URL=http://localhost:7860
