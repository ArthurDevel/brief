# E2E Email Test Credentials
# Copy to .env.test.local and fill in real values.
# See packages/email/src/__tests__/e2e/README.md for details.

# Unipile (shared)
UNIPILE_API_KEY=
UNIPILE_DSN=

# Gmail via Unipile
TEST_GMAIL_UNIPILE_ACCOUNT_ID=
TEST_GMAIL_UNIPILE_EMAIL=

# Outlook via Unipile
TEST_OUTLOOK_UNIPILE_ACCOUNT_ID=
TEST_OUTLOOK_UNIPILE_EMAIL=

# Gmail via IMAP/SMTP
TEST_GMAIL_IMAP_EMAIL=
TEST_GMAIL_IMAP_HOST=imap.gmail.com
TEST_GMAIL_IMAP_PORT=993
TEST_GMAIL_IMAP_USER=
TEST_GMAIL_IMAP_PASSWORD=
TEST_GMAIL_SMTP_HOST=smtp.gmail.com
TEST_GMAIL_SMTP_PORT=587
TEST_GMAIL_SMTP_USER=
TEST_GMAIL_SMTP_PASSWORD=

# Outlook via IMAP/SMTP
TEST_OUTLOOK_IMAP_EMAIL=
TEST_OUTLOOK_IMAP_HOST=outlook.office365.com
TEST_OUTLOOK_IMAP_PORT=993
TEST_OUTLOOK_IMAP_USER=
TEST_OUTLOOK_IMAP_PASSWORD=
TEST_OUTLOOK_SMTP_HOST=smtp.office365.com
TEST_OUTLOOK_SMTP_PORT=587
TEST_OUTLOOK_SMTP_USER=
TEST_OUTLOOK_SMTP_PASSWORD=
